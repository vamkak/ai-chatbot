# This is the one .env file for the whole course. Copy this file to .env, or let check.py
# copy it for you on its first run. .env is listed in .gitignore and never reaches GitHub.
# Exactly one provider block is active at a time: the three lines without a # at the start.
# To switch providers, put a # in front of the three active lines and remove the # from the other three.

# ---- Gemini, from Google AI Studio (https://aistudio.google.com/app/apikey). ACTIVE. ----
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=paste-your-gemini-key-here
LLM_MODEL=gemini-3.5-flash-lite
# check.py prints the model names your key can use. If the name above is not in that list, change it to one that is.

# ---- OpenRouter, from https://openrouter.ai/keys. Inactive until you remove the # signs (stage 6). ----
# Paste your OpenRouter key after LLM_API_KEY= on the line below (keep the # until you switch).
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=paste-your-openrouter-key-here
# LLM_MODEL=paste-a-model-name-ending-in-:free

# ---- Stage 9: the passphrase visitors must enter on the deployed page. ----
APP_PASSWORD=choose-a-word
